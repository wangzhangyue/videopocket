{
  "manifest_version": 3,
  "name": "拾影 · VideoPocket",
  "version": "0.2.2",
  "description": "保存多个网站的公开视频，支持MP4/WebM 与 HLS/DASH 点播。macOS 本地助手，最高 1080p。",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "拾影 · 保存视频"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
